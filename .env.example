# ---------------------------------------------------------------------------
# DVAA configuration. Copy to `.env` and edit.
# ---------------------------------------------------------------------------

# REQUIRED. The app refuses to start without this. By setting it you confirm you
# understand this application is DELIBERATELY VULNERABLE and must never be
# exposed to a network you do not control.
DVAA_I_UNDERSTAND=0

# Secret used to derive per-install CTF flags. Change it and every flag changes,
# so two workshop instances never share answers. Leave blank — the default — and
# one is generated on first boot and kept in the data directory alongside the
# database, which is the volume a container persists. Set it explicitly only if
# you need the same flags across a rebuilt data volume.
DVAA_FLAG_SALT=

# Session cookie signing key. Leave blank to generate and persist one the same
# way.
DVAA_SECRET_KEY=

# --- Bind address -----------------------------------------------------------
# Loopback only by default. Setting this to 0.0.0.0 exposes a vulnerable app to
# your network; the app will log a loud warning and require ALLOW_NETWORK_BIND.
DVAA_HOST=127.0.0.1
DVAA_PORT=8000
DVAA_ALLOW_NETWORK_BIND=0

# --- LLM provider -----------------------------------------------------------
# One of: ollama | anthropic | openai | fake
# `fake` is a scripted deterministic provider used by the test suite.
DVAA_PROVIDER=ollama

# Ollama (default, no API key, no bill)
# This is the *starting* model. The header has a picker that switches between
# whatever this Ollama has pulled, and that choice is remembered — so treat this
# as the first-boot default rather than the setting to keep editing. A 3B model
# is fast but loses the thread of a tool-calling loop; a 7B one makes the
# agentic challenges behave much more like production.
DVAA_OLLAMA_BASE_URL=http://localhost:11434
DVAA_OLLAMA_MODEL=llama3.2:3b

# Answers stream, so a long answer is never mistaken for a hung server. These
# two are the only limits left, both in seconds:
#   STALL_TIMEOUT — how long Ollama may send *nothing*. It covers loading a cold
#     model, not writing an answer. Raise it if a big model on a slow disk gets
#     killed before it produces its first token.
#   MAX_SECONDS — wall clock one generation may run once it is producing. This
#     is what stops "think endlessly about the digits of pi". Hitting it keeps
#     the partial answer instead of erroring.
DVAA_OLLAMA_STALL_TIMEOUT=120
DVAA_OLLAMA_MAX_SECONDS=900

# Anthropic (optional)
ANTHROPIC_API_KEY=
DVAA_ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (optional)
OPENAI_API_KEY=
DVAA_OPENAI_MODEL=gpt-4o-mini

# --- Storage ----------------------------------------------------------------
DVAA_DB_PATH=./data/dvaa.db
DVAA_CHROMA_PATH=./data/chroma

# --- Defaults ---------------------------------------------------------------
# Starting difficulty for every challenge: low | medium | high | impossible
DVAA_DEFAULT_LEVEL=low

# The level ladder. By default a challenge’s Medium opens when you capture its
# Low, and its High when you capture its Medium — watching a payload that
# worked one rung down stop working is the lesson, and a level dropdown lets a
# player skip it. Impossible is never locked either way. Set this to 1 to open
# every rung at once, for demonstrating one level or re-testing a challenge.
DVAA_UNLOCK_ALL=0

# --- Debugging --------------------------------------------------------------
# Log the raw JSON each provider call returns, before DVAA parses it. Turn this
# on when a model behaves in a way the on-screen trace cannot explain — it is
# the only way to tell "the model sent no tool arguments" from "we dropped
# them". Prints whole model responses to the console, so leave it off otherwise.
DVAA_DEBUG_PROVIDER=0
